{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api"
    },
    {
      "source": "/",
      "destination": "/frontend/Form.html"
    },
    {
      "source": "/:path((?!api/|uploads/).*)",
      "destination": "/frontend/:path"
    }
  ]
}
